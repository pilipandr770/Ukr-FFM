msgstr "Лот створено."

#: app/blueprints/admin/__init__.py:250
msgid "The lot is published."
msgstr "Лот опубліковано."

#: app/blueprints/admin/__init__.py:253
msgid "The lot is rejected."
msgstr "Лот відхилено."

#: app/blueprints/admin/__init__.py:257 app/modules/auction/__init__.py:64
msgid "This lot is not waiting for review."
msgstr "Цей лот не очікує перевірки."

#: app/blueprints/admin/__init__.py:267
