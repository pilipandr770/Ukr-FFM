#: app/services/tools/security_extra.py:225
#: app/services/tools/security_extra.py:503
#: app/services/tools/security_extra.py:580
msgid "."
msgstr "."

#: app/services/tools/security_extra.py:79
msgid "Keine typischen Schwächen erkannt."
msgstr "Типових слабких місць не виявлено."

#: app/services/tools/security_extra.py:80
msgid ""
"Die Policy verschärfen: kein 'unsafe-inline'/'unsafe-eval', Skriptquellen"
" einzeln benennen, object-src 'none' und base-uri 'self' setzen."
msgstr ""
"Посилити політику: відмовитися від 'unsafe-inline'/'unsafe-eval', "
"перелічити джерела скриптів, встановити object-src 'none' і base-uri "
"'self'."

#: app/services/tools/security_extra.py:85
msgid "CORS-Freigabe"
msgstr "Доступ CORS"

#: app/services/tools/security_extra.py:86
msgid ""
"Alle Herkünfte erlaubt, zusammen mit Zugangsdaten: gefährliche "
"Kombination."
msgstr ""
"Дозволено будь-які джерела разом з обліковими даними: небезпечна "
"комбінація."

#: app/services/tools/security_extra.py:87
msgid ""
"Alle Herkünfte dürfen die Antwort lesen (bei öffentlichen Inhalten meist "
"gewollt)."
msgstr ""
"Будь-яке джерело може читати відповідь (для публічного вмісту зазвичай це"
" припустимо)."

#: app/services/tools/security_extra.py:88
#, python-format
msgid "Freigabe nur für %(value0)s."
msgstr "Доступ дозволено лише для %(value0)s."

#: app/services/tools/security_extra.py:89
msgid ""
"Access-Control-Allow-Origin nicht auf * setzen, wenn Zugangsdaten oder "
"private Daten im Spiel sind."
msgstr ""
"Не встановлювати Access-Control-Allow-Origin: *, якщо використовуються "
"облікові або приватні дані."

#: app/services/tools/security_extra.py:93
msgid "Caching bei Seiten mit Cookies"
msgstr "Кешування сторінок із cookies"

#: app/services/tools/security_extra.py:94
msgid "Cache-Control schützt personenbezogene Antworten."
msgstr "Cache-Control захищає відповіді з персональними даними."

#: app/services/tools/security_extra.py:95
msgid ""
"Die Seite setzt Cookies, aber Cache-Control sagt nichts zu 'private' oder"
" 'no-store'."
msgstr ""
"Сторінка встановлює cookies, але в Cache-Control немає 'private' чи 'no-"
"store'."

#: app/services/tools/security_extra.py:96
msgid ""
"Bei Seiten mit persönlichen Inhalten Cache-Control: private bzw. no-store"
" setzen."
msgstr ""
"Для сторінок з персональними даними встановити Cache-Control: private або"
" no-store."

#: app/services/tools/security_extra.py:100
msgid "HSTS-Preload"
msgstr "Передзавантаження HSTS"

#: app/services/tools/security_extra.py:101
msgid "Erfüllt die Voraussetzungen für die Browser-Preload-Liste."
msgstr "Умови для включення до списку передзавантаження браузерів виконано."

#: app/services/tools/security_extra.py:102
msgid ""
"Noch nicht preload-fähig (max-age ≥ 1 Jahr, includeSubDomains und preload"
" nötig)."
msgstr ""
"Умов передзавантаження поки не виконано: потрібні max-age ≥ 1 року, "
"includeSubDomains і preload."

#: app/services/tools/security_extra.py:103
msgid ""
"Optional: HSTS mit max-age=31536000; includeSubDomains; preload setzen "
"und auf hstspreload.org eintragen."
msgstr ""
"За потреби встановити HSTS max-age=31536000; includeSubDomains; preload і"
" зареєструвати на hstspreload.org."

#: app/services/tools/security_extra.py:105
msgid "Moderne Isolations-Header (COOP/CORP)"
msgstr "Сучасні заголовки ізоляції (COOP/CORP)"

#: app/services/tools/security_extra.py:106
msgid "Nicht gesetzt (optional, stärkt die Trennung der Seite)."
msgstr "Не встановлено (необов'язково, посилюють ізоляцію сторінки)."

#: app/services/tools/security_extra.py:107
msgid ""
"Optional Cross-Origin-Opener-Policy: same-origin setzen, wenn keine Pop-"
"ups fremder Seiten nötig sind."
msgstr ""
"За потреби встановити Cross-Origin-Opener-Policy: same-origin, якщо не "
"потрібні спливні вікна сторонніх сайтів."

#: app/services/tools/security_extra.py:203
msgid "Keine unsicheren Inhalte auf der HTTPS-Seite"
msgstr "Немає незахищених ресурсів на HTTPS-сторінці"

#: app/services/tools/security_extra.py:204
#, python-format
msgid "%(value0)s Inhalt(e) über http geladen, z. B. %(value1)s."
msgstr "За http завантажується ресурсів: %(value0)s, наприклад %(value1)s."

#: app/services/tools/security_extra.py:205
msgid "Keine http-Inhalte auf der Startseite gefunden."
msgstr "На головній сторінці ресурсів за http не знайдено."

#: app/services/tools/security_extra.py:206
msgid ""
"Alle Skripte, Bilder und Formulare über https laden (Mixed Content "
"beheben)."
msgstr ""
"Завантажувати всі скрипти, зображення та форми за https (усунути змішаний"
" вміст)."

#: app/services/tools/security_extra.py:208
msgid "Drittanbieter-Quellen auf der Startseite"
msgstr "Сторонні джерела на головній сторінці"

#: app/services/tools/security_extra.py:209
#, python-format
msgid "%(value0)s fremde Quelle(n): %(value1)s."
msgstr "Сторонніх джерел: %(value0)s; %(value1)s."

#: app/services/tools/security_extra.py:210
msgid "Skripte, Schriften und Frames kommen nur von der eigenen Domain."
msgstr "Скрипти, шрифти та фрейми завантажуються лише з власного домену."

#: app/services/tools/security_extra.py:211
msgid ""
"Jede fremde Quelle prüfen: wird sie wirklich gebraucht, steht sie in der "
"Datenschutzerklärung?"
msgstr ""
"Перевірити кожне стороннє джерело: чи воно справді потрібне і чи вказане "
"в політиці конфіденційності?"

#: app/services/tools/security_extra.py:215
msgid "Fremde Skripte ohne Integritätsprüfung (SRI)"
msgstr "Сторонні скрипти без перевірки цілісності (SRI)"

#: app/services/tools/security_extra.py:216
#, python-format
msgid "%(value0)s fremde(s) Skript(e) ohne integrity-Attribut, z. B. %(value1)s."
msgstr ""
"Сторонніх скриптів без атрибута integrity: %(value0)s, наприклад "
"%(value1)s."

#: app/services/tools/security_extra.py:217
msgid ""
"Bei fremden Skripten ein integrity-Attribut setzen oder die Dateien "
"selbst hosten."
msgstr ""
"Встановити integrity для сторонніх скриптів або розмістити файли на "
"власному сервері."

#: app/services/tools/security_extra.py:219
msgid "Passwortfelder nur über https"
msgstr "Поля пароля лише за https"

#: app/services/tools/security_extra.py:220
msgid "Ein Formular mit Passwortfeld sendet die Daten über http."
msgstr "Форма з полем пароля надсилає дані за http."

#: app/services/tools/security_extra.py:221
msgid "Keine Passwortformulare mit unsicherem Ziel gefunden."
msgstr "Форм із паролем і незахищеною адресою надсилання не знайдено."

#: app/services/tools/security_extra.py:222
msgid "Formulare mit Passwortfeld ausschließlich über https absenden."
msgstr "Надсилати форми з паролем виключно за https."

#: app/services/tools/security_extra.py:224
msgid "Sichtbare Software-Versionen"
msgstr "Видимі версії ПЗ"

#: app/services/tools/security_extra.py:225
msgid "Keine veralteten oder verratenen Versionen in Seite und Headern erkannt."
msgstr "Застарілих або розкритих версій на сторінці та в заголовках не виявлено."

#: app/services/tools/security_extra.py:226
msgid ""
"Veraltete Komponenten aktualisieren und Versionsangaben aus Seite und "
"Headern entfernen."
msgstr "Оновити застарілі компоненти та прибрати версії зі сторінки й заголовків."

#: app/services/tools/security_extra.py:265
msgid "DMARC für Subdomains"
msgstr "DMARC для піддоменів"

#: app/services/tools/security_extra.py:265
msgid "Subdomains haben die schwächere Richtlinie sp=none."
msgstr "Для піддоменів діє слабша політика sp=none."

#: app/services/tools/security_extra.py:266
msgid "sp auf quarantine oder reject setzen oder entfernen."
msgstr "Встановити sp=quarantine або sp=reject чи видалити sp."

#: app/services/tools/security_extra.py:269
msgid "DMARC-Anteil"
msgstr "Частка застосування DMARC"

#: app/services/tools/security_extra.py:269
#, python-format
msgid "Die Richtlinie gilt nur für %(value0)s %% der Mails."
msgstr "Політика застосовується лише до %(value0)s %% листів."

#: app/services/tools/security_extra.py:270
msgid "pct nach der Testphase auf 100 setzen."
msgstr "Після тестового періоду встановити pct=100."

#: app/services/tools/security_extra.py:272
msgid "DMARC-Berichte"
msgstr "Звіти DMARC"

#: app/services/tools/security_extra.py:272
msgid "Keine Adresse für Auswertungsberichte (rua) eingetragen."
msgstr "Адресу для зведених звітів (rua) не вказано."

#: app/services/tools/security_extra.py:273
msgid ""
"Eine rua-Adresse eintragen, um Missbrauch und Fehlkonfigurationen zu "
"sehen."
msgstr "Додати адресу rua, щоб бачити зловживання та помилки налаштування."

#: app/services/tools/security_extra.py:352
#: app/services/tools/security_extra.py:358
msgid "security.txt aktuell"
msgstr "Актуальність security.txt"

#: app/services/tools/security_extra.py:353
msgid "Das Ablaufdatum (Expires) ist überschritten."
msgstr "Дата Expires минула."

#: app/services/tools/security_extra.py:353
msgid "Ablaufdatum liegt in der Zukunft."
msgstr "Дата Expires ще не настала."

#: app/services/tools/security_extra.py:354
msgid "Das Expires-Datum in der security.txt erneuern."
msgstr "Оновити дату Expires у security.txt."

#: app/services/tools/security_extra.py:358
msgid "Kein Expires-Feld (nach RFC 9116 vorgeschrieben)."
msgstr "Немає поля Expires (обов'язкове за RFC 9116)."

#: app/services/tools/security_extra.py:359
msgid "Ein Expires-Feld mit einem Datum in höchstens einem Jahr ergänzen."
msgstr "Додати Expires з датою не пізніше ніж через рік."

#: app/services/tools/security_extra.py:429
msgid "TLS 1.3"
msgstr "TLS 1.3"

#: app/services/tools/security_extra.py:430
msgid "Der Server unterstützt TLS 1.3."
msgstr "Сервер підтримує TLS 1.3."

#: app/services/tools/security_extra.py:430
msgid "TLS 1.3 wird nicht angeboten."
msgstr "TLS 1.3 не пропонується."

#: app/services/tools/security_extra.py:431
msgid "TLS 1.3 beim Hoster aktivieren (schneller und sicherer)."
msgstr "Увімкнути TLS 1.3 у хостинг-провайдера (швидше й безпечніше)."

#: app/services/tools/security_extra.py:433
#: app/services/tools/security_extra.py:437
msgid "Veraltete TLS-Versionen"
msgstr "Застарілі версії TLS"

#: app/services/tools/security_extra.py:434
msgid "Der Server akzeptiert TLS 1.0 oder 1.1, die als unsicher gelten."
msgstr "Сервер приймає TLS 1.0 або 1.1, які вважаються небезпечними."

#: app/services/tools/security_extra.py:435
msgid "TLS 1.0 und 1.1 abschalten; nur TLS 1.2 und 1.3 zulassen."
msgstr "Вимкнути TLS 1.0 і 1.1; дозволити лише TLS 1.2 і 1.3."

#: app/services/tools/security_extra.py:438
msgid "TLS 1.0/1.1 wurden nicht akzeptiert (Best-Effort-Test)."
msgstr "TLS 1.0/1.1 не було прийнято (перевірка в межах доступних можливостей)."

#: app/services/tools/security_extra.py:446
#: app/services/tools/security_extra.py:449
msgid "Mailserver (MX)"
msgstr "Поштові сервери (MX)"

#: app/services/tools/security_extra.py:446
msgid "Die Domain hat keinen MX-Eintrag und empfängt keine Mails."
msgstr "У домену немає MX-запису, він не приймає пошту."

#: app/services/tools/security_extra.py:447
msgid ""
"Wenn die Domain nie Mails versendet, SPF „v=spf1 -all“ und DMARC p=reject"
" setzen."
msgstr ""
"Якщо домен ніколи не надсилає пошту, встановити SPF «v=spf1 -all» і DMARC"
" p=reject."

#: app/services/tools/security_extra.py:449
#, python-format
msgid "%(value0)s MX-Eintrag/Einträge vorhanden."
msgstr "MX-записів: %(value0)s."

#: app/services/tools/security_extra.py:453
msgid "SPF: Anzahl der DNS-Abfragen"
msgstr "SPF: кількість DNS-запитів"

#: app/services/tools/security_extra.py:454
#, python-format
msgid "%(value0)s Abfragen; erlaubt sind höchstens 10, sonst wird SPF ungültig."
msgstr "Запитів: %(value0)s; допускається не більше 10, інакше SPF недійсний."

#: app/services/tools/security_extra.py:455
#, python-format
msgid "%(value0)s von höchstens 10 Abfragen."
msgstr "Запитів: %(value0)s із дозволених 10."

#: app/services/tools/security_extra.py:456
msgid ""
"SPF vereinfachen: überflüssige includes entfernen oder Versender "
"zusammenfassen."
msgstr "Спростити SPF: прибрати зайві include або об'єднати відправників."

#: app/services/tools/security_extra.py:458
msgid "SPF: ptr-Mechanismus"
msgstr "SPF: механізм ptr"

#: app/services/tools/security_extra.py:458
msgid "ptr ist veraltet und langsam."
msgstr "ptr застарів і працює повільно."

#: app/services/tools/security_extra.py:458
msgid "ptr aus dem SPF-Eintrag entfernen."
msgstr "Прибрати ptr із запису SPF."

#: app/services/tools/security_extra.py:468
msgid "MTA-STS (verschlüsselter Mailempfang)"
msgstr "MTA-STS (зашифрований прийом пошти)"

#: app/services/tools/security_extra.py:469
msgid "Aktiv im Modus enforce."
msgstr "Активний у режимі enforce."

#: app/services/tools/security_extra.py:469
#, python-format
msgid "Eingerichtet, aber Modus „%(value0)s“."
msgstr "Налаштований, але в режимі «%(value0)s»."

#: app/services/tools/security_extra.py:470
msgid "Nicht eingerichtet (empfohlen, wenn die Domain Mails empfängt)."
msgstr "Не налаштований (рекомендується, якщо домен приймає пошту)."

#: app/services/tools/security_extra.py:471
msgid ""
"MTA-STS mit mode: enforce einrichten, damit eingehende Mails "
"verschlüsselt zugestellt werden."
msgstr ""
"Налаштувати MTA-STS з mode: enforce для зашифрованої доставки вхідної "
"пошти."

#: app/services/tools/security_extra.py:473
msgid "TLS-RPT (Berichte zur Mailverschlüsselung)"
msgstr "TLS-RPT (звіти про шифрування пошти)"

#: app/services/tools/security_extra.py:474
msgid "Eingerichtet."
msgstr "Налаштовано."

#: app/services/tools/security_extra.py:474
msgid "Nicht eingerichtet (optional)."
msgstr "Не налаштовано (необов'язково)."

#: app/services/tools/security_extra.py:475
msgid ""
"Optional einen TLS-RPT-Eintrag anlegen, um Zustellprobleme der "
"Verschlüsselung zu sehen."
msgstr ""
"За потреби додати TLS-RPT для виявлення проблем шифрування під час "
"доставки."

#: app/services/tools/security_extra.py:483
msgid "Namenserver"
msgstr "Сервери імен"

#: app/services/tools/security_extra.py:484
#, python-format
msgid "%(value0)s Namenserver eingetragen."
msgstr "Серверів імен: %(value0)s."

#: app/services/tools/security_extra.py:484
msgid "Nur ein Namenserver: fällt er aus, ist die Domain weg."
msgstr "Лише один сервер імен: у разі його відмови домен стане недоступним."

#: app/services/tools/security_extra.py:485
msgid ""
"Mindestens zwei Namenserver, am besten bei unterschiedlichen Anbietern, "
"eintragen."
msgstr "Вказати не менше двох серверів імен, бажано в різних провайдерів."

#: app/services/tools/security_extra.py:491
msgid "Verwaiste Weiterleitung (CNAME)"
msgstr "Застаріле перенаправлення (CNAME)"

#: app/services/tools/security_extra.py:492
msgid "Die www-Adresse zeigt auf ein erreichbares Ziel."
msgstr "Адреса www вказує на доступний ресурс."

#: app/services/tools/security_extra.py:493
#, python-format
msgid ""
"www zeigt auf %(value0)s, das nicht mehr existiert: Übernahme durch "
"Fremde möglich (Subdomain Takeover)."
msgstr ""
"www вказує на неіснуючий %(value0)s: можливе захоплення піддомену "
"сторонніми."

#: app/services/tools/security_extra.py:494
msgid "Den CNAME-Eintrag löschen oder auf ein existierendes Ziel umstellen."
msgstr "Видалити CNAME або спрямувати його на наявний ресурс."

#: app/services/tools/security_extra.py:502
#: app/services/tools/security_extra.py:507
msgid "Domain-Laufzeit"
msgstr "Строк реєстрації домену"

#: app/services/tools/security_extra.py:505
msgid ""
"Automatische Verlängerung beim Registrar aktivieren und eine gepflegte "
"Kontakt-Adresse hinterlegen."
msgstr ""
"Увімкнути автоматичне подовження в реєстратора та вказати актуальну "
"контактну адресу."

#: app/services/tools/security_extra.py:508
msgid ""
"Die Registrierungsstelle dieser Endung veröffentlicht kein Ablaufdatum "
"(bei .de üblich)."
msgstr ""
"Реєстр цієї доменної зони не публікує дату закінчення реєстрації "
"(зазвичай для .de)."

#: app/services/tools/security_extra.py:509
msgid ""
"Im Kundenkonto des Registrars prüfen, wann die Domain abläuft, und "
"automatische Verlängerung aktivieren."
msgstr ""
"Перевірити строк реєстрації в кабінеті реєстратора та ввімкнути "
"автоматичне подовження."

#: app/services/tools/security_extra.py:516
msgid "Hinweise in der robots.txt"
msgstr "Вказівки в robots.txt"

#: app/services/tools/security_extra.py:518
msgid ""
"Sensible Bereiche per Zugangsschutz sichern; die robots.txt ist kein "
"Schutz."
msgstr "Захистити чутливі розділи авторизацією; robots.txt не забезпечує захисту."

#: app/services/tools/security_extra.py:570
#: app/services/tools/security_extra.py:573
#: app/services/tools/security_extra.py:576
msgid "Öffentlich sichtbare Subdomains"
msgstr "Публічно видимі піддомени"

#: app/services/tools/security_extra.py:570
msgid "Die Zertifikats-Verzeichnisse waren nicht erreichbar."
msgstr "Довідники сертифікатів були недоступні."

#: app/services/tools/security_extra.py:573
msgid "In den öffentlichen Zertifikatslisten wurden keine Subdomains gefunden."
msgstr "У публічних списках сертифікатів піддомени не знайдено."

#: app/services/tools/security_extra.py:575
#, python-format
msgid "%(count)s subdomains in public certificate logs, for example %(examples)s."
msgstr ""
"Піддоменів у публічних журналах сертифікатів: %(count)s, наприклад "
"%(examples)s."

#: app/services/tools/security_extra.py:577
msgid ""
"Prüfen, ob alle Subdomains noch gebraucht werden; nicht mehr genutzte "
"Einträge entfernen."
msgstr "Перевірити потребу в усіх піддоменах; видалити невикористовувані записи."

#: app/services/tools/security_extra.py:579
msgid "Subdomains, die nach Test- oder Verwaltungssystemen aussehen"
msgstr "Піддомени, схожі на тестові або адміністративні системи"

#: app/services/tools/security_extra.py:581
msgid ""
"Test-, Admin- und Entwicklungssysteme nicht öffentlich erreichbar lassen "
"oder mit Zugangsschutz sichern."
msgstr ""
"Закрити публічний доступ до тестових, адміністративних і розроблюваних "
"систем або захистити їх авторизацією."

#: app/services/tools/seo.py:126
msgid "Unter dieser Adresse liegt keine Webseite (kein HTML)."
msgstr "За цією адресою немає веб-сторінки (не HTML)."

#: app/services/tools/seo.py:142
msgid "Sichere Verbindung (HTTPS)"
msgstr "Захищене з'єднання (HTTPS)"

#: app/services/tools/seo.py:143
msgid "Die Seite wird über HTTPS ausgeliefert."
msgstr "Сторінка передається за HTTPS."

#: app/services/tools/seo.py:143
msgid "Die Seite lädt ohne HTTPS."
msgstr "Сторінка завантажується без HTTPS."

#: app/services/tools/seo.py:144
msgid ""
"HTTPS einrichten und alle http-Adressen dauerhaft (301) auf https "
"umleiten."
msgstr ""
"Налаштувати HTTPS і постійне перенаправлення всіх http-адрес на https "
"(301)."

#: app/services/tools/seo.py:146
msgid "Antwortzeit des Servers"
msgstr "Час відповіді сервера"

#: app/services/tools/seo.py:146
#, python-format
msgid "%(value0)s Sekunden bis das HTML da ist."
msgstr "HTML отримано за %(value0)s с."

#: app/services/tools/seo.py:147
msgid ""
